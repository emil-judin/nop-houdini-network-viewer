<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <!-- NOP shelf, loaded by the NOP Houdini package (packages/nop.json sets $NOP_EXPORTER_ROOT to this folder and adds it to HOUDINI_PATH). -->

  <toolshelf name="nop" label="NOP">
    <memberTool name="nop_export"/>
    <memberTool name="nop_copy"/>
  </toolshelf>

  <!-- Adds the NOP shelf as a tab to the default shelf set at the top of the window. -->
  <shelfSetEdit name="shelf_set_1" fileLocation="$HFS/houdini/toolbar/ShelfDefinitions.shelf">
    <addMemberToolshelf name="nop"/>
  </shelfSetEdit>

  <tool name="nop_export" label="Export for NOP" icon="$NOP_EXPORTER_ROOT/icons/nop.png">
    <helpText><![CDATA[Export the current network (or the selected nodes) for the NOP web viewer: copy to the clipboard or save a .json file.]]></helpText>
    <script scriptType="python"><![CDATA[import sys

# The package puts scripts/python on the Python path; this keeps the tool working if it does not
_nop_python = hou.expandString("$NOP_EXPORTER_ROOT/scripts/python")
if _nop_python not in sys.path:
    sys.path.append(_nop_python)

import nop_exporter
nop_exporter.run_interactive_export(kwargs.get("pane"))
]]></script>
  </tool>

  <tool name="nop_copy" label="Copy for NOP" icon="$NOP_EXPORTER_ROOT/icons/nop.png">
    <helpText><![CDATA[Copy the selected nodes of the Network Editor under the mouse (or the whole network) as compact JSON, without a dialog. Paste it into the NOP playground with Ctrl+V. Bind it to a hotkey such as Ctrl+Shift+Alt+C.]]></helpText>
    <script scriptType="python"><![CDATA[import sys

_nop_python = hou.expandString("$NOP_EXPORTER_ROOT/scripts/python")
if _nop_python not in sys.path:
    sys.path.append(_nop_python)

import nop_exporter
nop_exporter.copy_selection_for_web(kwargs.get("pane"))
]]></script>
  </tool>
</shelfDocument>
