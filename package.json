{
  "name": "wop-houdini-network-viewer",
  "version": "0.1.0-alpha.1",
  "description": "WOP: View and share Houdini node networks on the web. Interactive, view-only viewer for SideFX Houdini node networks on portfolio websites and technical documentation. Not affiliated with SideFX.",
  "author": "Emil Judin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emil-judin/wop-houdini-network-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/emil-judin/wop-houdini-network-viewer/issues"
  },
  "homepage": "https://github.com/emil-judin/wop-houdini-network-viewer#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./web-component": {
      "types": "./dist/types/web-component.d.ts",
      "import": "./dist/web-component.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "*.css",
    "./dist/web-component.js"
  ],
  "files": [
    "dist",
    "exporter/wop_exporter.py",
    "exporter/README.md",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:exporter && vite",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build:exporter && vite build",
    "build:exporter": "node scripts/build_exporter_package.mjs",
    "build:lib": "vite build -c vite.lib.config.ts --mode npm && vite build -c vite.lib.config.ts --mode web-component && tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run check && npm run lint && npm run build:lib",
    "sri": "node scripts/print_sri.mjs"
  },
  "keywords": [
    "houdini",
    "sidefx",
    "node-graph",
    "wop",
    "viewer",
    "network-viewer",
    "sop",
    "vex",
    "portfolio",
    "technical-art"
  ],
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@xyflow/react": "^12.4.2",
    "lucide-react": "^1.61.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/source-code-pro": "^5.3.1",
    "@fontsource/source-sans-pro": "^5.3.0",
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "magic-string": "^1.4.3",
    "postcss": "^8.5.31",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
