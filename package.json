{
  "name": "nop-houdini-network-viewer",
  "version": "0.1.0-alpha.7",
  "description": "Interactive viewer for SideFX Houdini node networks on the web. Export networks from Houdini, embed them on any page and inspect them on desktop and mobile.",
  "author": "Emil Judin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emil-judin/nop-houdini-network-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/emil-judin/nop-houdini-network-viewer/issues"
  },
  "homepage": "https://github.com/emil-judin/nop-houdini-network-viewer#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./web-component": {
      "types": "./dist/types/web-component.d.ts",
      "import": "./dist/web-component.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "*.css",
    "./dist/web-component.js"
  ],
  "files": [
    "dist",
    "exporter/nop_exporter.py",
    "exporter/README.md",
    "schema",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:exporter && vite",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run_vitest.mjs run",
    "test:watch": "node scripts/run_vitest.mjs",
    "test:coverage": "node scripts/run_vitest.mjs run --coverage",
    "test:exporter": "python -m unittest discover -s exporter/tests",
    "test:exporter:houdini": "node scripts/run_houdini_exporter_tests.mjs",
    "test:e2e": "playwright test",
    "build": "npm run build:exporter && vite build",
    "build:exporter": "node scripts/build_exporter_package.mjs",
    "build:lib": "vite build -c vite.lib.config.ts --mode npm && vite build -c vite.lib.config.ts --mode web-component && tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run check && npm run lint && npm test && npm run build:lib",
    "sri": "node scripts/print_sri.mjs"
  },
  "keywords": [
    "houdini",
    "sidefx",
    "node-graph",
    "nop",
    "viewer",
    "network-viewer",
    "sop",
    "vex",
    "portfolio",
    "technical-art"
  ],
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "html-to-image": "1.11.13",
    "lucide-react": "^1.70.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.1",
    "@fontsource/source-sans-pro": "^5.3.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^27.4.0",
    "magic-string": "^1.4.5",
    "playwright-core": "1.64.0",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.1.0",
    "vitest": "^4.1.12"
  }
}
